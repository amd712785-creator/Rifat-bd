rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'amd712785@gmail.com' ||
        request.auth.token.email == 'rifatyt123042@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Admin collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Users collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) &&
        request.resource.data.uid == userId &&
        (!('role' in request.resource.data) || request.resource.data.role == 'user' || isAdmin()) &&
        (!('isVIP' in request.resource.data) || request.resource.data.isVIP == false || isAdmin());
      allow update: if (isOwner(userId) &&
        request.resource.data.uid == userId &&
        // Non-admin users cannot alter role or isVIP
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isVIP', 'vipExpiresAt'])))
        || isAdmin();
      allow delete: if isAdmin();
    }

    // Watchlists
    match /watchlists/{watchlistId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Watch History
    match /watchHistory/{historyId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Payments for VIP membership
    match /payments/{paymentId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.status == 'pending';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Live TV Favorites
    match /liveTvFavorites/{favoriteId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Real Analytics View Events
    match /viewEvents/{eventId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Admin Settings (public read for VIP plans, bKash info, etc.; write admin only)
    match /adminSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Custom Content collections (movies, tvShows, episodes)
    match /movies/{movieId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tvShows/{showId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /episodes/{episodeId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
